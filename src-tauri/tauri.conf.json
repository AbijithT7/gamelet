{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamelet",
  "version": "0.1.0",
  "identifier": "com.abijith.gamelet",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gamelet",
        "width": 260,
        "height": 295,
        "minWidth": 260,
        "minHeight": 295,
        "maxWidth": 260,
        "maxHeight": 295,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Abijith",
    "shortDescription": "Tiny games right on your desktop",
    "longDescription": "A lightweight Windows desktop application for offline mini-games in compact widget windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
